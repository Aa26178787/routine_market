DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_LOG_LEVEL=INFO

# 개발 환경은 재설정 메일을 터미널에 출력합니다. 운영 환경에서는 SMTP 백엔드와
# 서버별 이메일 설정을 추가해 실제 메일 발송 서비스에 연결합니다.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@routine-market.local
# AWS SES(서울 리전) 사용 시 SMTP 백엔드로 변경하고 SES SMTP 자격 증명을 입력합니다.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=email-smtp.ap-northeast-2.amazonaws.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true

# 토스페이먼츠 개발자센터의 주문서형·결제창형 테스트 키(test_gck_/test_gsk_)를 사용하세요.
# 클라이언트 키는 결제창에 노출되지만 시크릿 키는 서버 환경변수로만 관리합니다.
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
TOSS_PAYMENTS_API_BASE_URL=https://api.tosspayments.com
TOSS_PAYMENTS_TIMEOUT=10

# PostgreSQL을 사용할 때 DB_ENGINE을 postgresql로 설정합니다.
DB_ENGINE=sqlite
DB_NAME=routine_market
DB_USER=routine_market_user
# 비밀번호 환경변수 대신 로컬 pgpass.conf 또는 배포 환경의 비밀 저장소를 권장합니다.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# S3를 사용할 때 true로 바꾸고 비공개 버킷 이름을 설정합니다.
# AWS 자격 증명은 이 파일에 넣지 않고 로컬 프로필 또는 EC2 IAM 역할을 사용합니다.
AWS_PROFILE=routine-market
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-northeast-2
AWS_MEDIA_LOCATION=media
# 기본값은 선택한 AWS 리전 엔드포인트입니다. S3 호환 저장소만 별도로 설정합니다.
# AWS_S3_ENDPOINT_URL=http://localhost:4566

# 생략 시 로컬은 proxy, S3는 redirect가 자동 적용됩니다.
# PRIVATE_FILE_DELIVERY=proxy
DOWNLOAD_URL_EXPIRES=300
