DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL을 사용할 때 DB_ENGINE을 postgresql로 설정합니다.
DB_ENGINE=sqlite
DB_NAME=routine_market
DB_USER=routine_market_user
# 비밀번호 환경변수 대신 로컬 pgpass.conf 또는 배포 환경의 비밀 저장소를 권장합니다.
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# S3를 사용할 때 true로 바꾸고 비공개 버킷 이름을 설정합니다.
# AWS 자격 증명은 이 파일에 넣지 않고 로컬 프로필 또는 EC2 IAM 역할을 사용합니다.
AWS_PROFILE=routine-market
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-northeast-2
AWS_MEDIA_LOCATION=media
# LocalStack 등 S3 호환 저장소를 사용할 때만 설정합니다.
AWS_S3_ENDPOINT_URL=

# 생략 시 로컬은 proxy, S3는 redirect가 자동 적용됩니다.
# PRIVATE_FILE_DELIVERY=proxy
DOWNLOAD_URL_EXPIRES=300
