DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL을 사용할 때 DB_ENGINE을 postgresql로 설정합니다.
DB_ENGINE=sqlite
DB_NAME=routine_market
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# 로컬: proxy, S3 운영 환경: redirect
PRIVATE_FILE_DELIVERY=proxy
DOWNLOAD_URL_EXPIRES=300
